DATABASE_URL="postgresql://periplus:periplus@127.0.0.1:5432/periplus?schema=public&connection_limit=5"

# OpenDAL object storage. S3-compatible endpoints may be configured here.
PERIPLUS_STORAGE_SCHEME="s3"
PERIPLUS_STORAGE_BUCKET="periplus"
PERIPLUS_STORAGE_REGION="us-east-1"
PERIPLUS_STORAGE_ENDPOINT="http://127.0.0.1:9000"
PERIPLUS_STORAGE_ACCESS_KEY_ID=""
PERIPLUS_STORAGE_SECRET_ACCESS_KEY=""
# Used only by the fs backend; memory is available for isolated tests.
PERIPLUS_STORAGE_ROOT="./uploads"

# Login bypass only takes effect with NODE_ENV=development. Uses shared local data.
PERIPLUS_DEVELOPER_MODE="false"

NEXT_PUBLIC_PERIPLUS_APP_URL="http://localhost:3001"
NEXT_PUBLIC_PERIPLUS_SHOW_MOCK_ACCOUNTS="true"
NEXT_PUBLIC_AMAP_KEY="your-amap-key"
PERIPLUS_AMAP_WEB_SERVICE_KEY="your-amap-web-service-key"
PERIPLUS_MCT_5A_SOURCE_URL="https://sjfw.mct.gov.cn/site/dataservice/rural?type=10"

PERIPLUS_FRONTEND_ORIGIN="http://localhost:3001"
BETTER_AUTH_SECRET="replace-this-dev-secret-before-production"

# Local PaddleOCR basic serving; no bill images are sent to a hosted model.
PERIPLUS_OCR_URL=http://127.0.0.1:8106/ocr
PERIPLUS_OCR_TIMEOUT_MS=60000
