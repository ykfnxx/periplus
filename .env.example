DATABASE_URL="file:./dev.db"

NEXT_PUBLIC_PERIPLUS_APP_URL="http://localhost:3001"
NEXT_PUBLIC_PERIPLUS_BACKEND_URL="http://127.0.0.1:3002"
NEXT_PUBLIC_PERIPLUS_SHOW_MOCK_ACCOUNTS="true"
NEXT_PUBLIC_AMAP_KEY="your-amap-key"
PERIPLUS_AMAP_WEB_SERVICE_KEY="your-amap-web-service-key"
PERIPLUS_ROLLINGGO_API_KEY="your-rollinggo-api-key"
PERIPLUS_ROLLINGGO_HOTEL_URL="https://mcp.rollinggo.cn/mcp"
PERIPLUS_TRANSIT_PLAN_RETENTION="SESSION_ONLY"
PERIPLUS_MCT_5A_SOURCE_URL="https://sjfw.mct.gov.cn/site/dataservice/rural?type=10"

PERIPLUS_FRONTEND_ORIGIN="http://localhost:3001"
PERIPLUS_BACKEND_HOST="127.0.0.1"
PERIPLUS_BACKEND_PORT="3002"
BETTER_AUTH_SECRET="replace-this-dev-secret-before-production"

PERIPLUS_KIMI_BIN="/path/to/.kimi-code/bin/kimi"
PERIPLUS_KIMI_HOME_SOURCE="/path/to/.kimi-code"

PERIPLUS_AGENT_RUNTIME="kimi"
PERIPLUS_PI_BIN="/path/to/periplus/node_modules/.bin/pi"
PERIPLUS_PI_TIMEOUT_MS="120000"
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_MODEL="deepseek-v4-flash"

PERIPLUS_OBSERVABILITY_ENABLED="true"
PERIPLUS_OBSERVABILITY_ID_SALT="replace-with-a-private-observability-salt"
OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4318"
OTEL_SERVICE_NAME="periplus-backend"
OTEL_RESOURCE_ATTRIBUTES="deployment.environment=development"
PERIPLUS_OBSERVABILITY_BIND_HOST="127.0.0.1"
PERIPLUS_GRAFANA_PORT="3003"
PERIPLUS_PHOENIX_PORT="6008"

# Required at runtime by `npm run observability:up`; do not commit these values.
# GRAFANA_ADMIN_USER=""
# GRAFANA_ADMIN_PASSWORD=""
