{
  "name": "periplus",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest --project=unit",
    "test:schema": "vitest --project=unit --run tests/unit/modules/data/schema-baseline.test.ts",
    "test:storybook": "vitest --project=storybook",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "db:seed": "tsx prisma/seed.ts",
    "places:import-mct-5a": "tsx scripts/import-mct-5a.ts",
    "places:import-mct-5a:mock": "tsx scripts/import-mct-5a.ts --mock",
    "places:enrich-mct-5a": "tsx scripts/enrich-mct-5a.ts",
    "places:review-matches": "tsx scripts/review-place-matches.ts"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@amap/amap-jsapi-types": "^0.0.15",
    "@base-ui/react": "1.9.0",
    "@better-auth/prisma-adapter": "^1.6.23",
    "@dnd-kit/react": "0.5.1",
    "@prisma/client": "^6.19.3",
    "@types/amap-js-api-scale": "^1.4.5",
    "@types/amap-js-api-tool-bar": "^1.4.4",
    "better-auth": "^1.6.23",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "motion": "12.43.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "opendal": "0.49.13",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "4.14.7",
    "supercluster": "9.1.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/nextjs-vite": "^10.5.5",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "pg": "8.16.3",
    "playwright": "^1.61.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "storybook": "^10.5.5",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
