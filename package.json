{
  "name": "periplus",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "next dev -p 3001",
    "dev:backend": "tsx backend/main.ts",
    "dev:mcp:workspace": "tsx backend/mcp/server.ts",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest --project=unit",
    "test:schema": "vitest --project=unit --run tests/unit/modules/data/schema-baseline.test.ts",
    "test:storybook": "vitest --project=storybook",
    "test:map-integration": "vitest --config vitest.map-integration.config.ts --run",
    "test:e2e": "playwright test",
    "eval:agent:smoke": "tsx scripts/eval-agent-capabilities.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "observability:up": "docker compose -f ops/observability/compose.yaml up -d",
    "observability:down": "docker compose -f ops/observability/compose.yaml down",
    "db:seed": "tsx prisma/seed.ts",
    "places:import-mct-5a": "tsx scripts/import-mct-5a.ts",
    "places:import-mct-5a:mock": "tsx scripts/import-mct-5a.ts --mock",
    "places:enrich-mct-5a": "tsx scripts/enrich-mct-5a.ts",
    "places:review-matches": "tsx scripts/review-place-matches.ts"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@amap/amap-jsapi-types": "^0.0.15",
    "@arizeai/openinference-core": "^2.5.1",
    "@arizeai/openinference-semantic-conventions": "^2.7.0",
    "@better-auth/prisma-adapter": "^1.6.23",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@prisma/client": "^6.19.3",
    "@types/amap-js-api-scale": "^1.4.5",
    "@types/amap-js-api-tool-bar": "^1.4.4",
    "better-auth": "^1.6.23",
    "clsx": "^2.1.1",
    "exif-js": "^2.3.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "typebox": "1.3.7",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/nextjs-vite": "^10.5.5",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "storybook": "^10.5.5",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
