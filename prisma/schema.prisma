generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum EdgeStatus {
  PLANNED
  INCOMPLETE
}

enum TransportMode {
  FLIGHT
  TRAIN
  CAR
  BUS
  WALK
  TAXI
  SUBWAY
  RENTAL
}

enum RouteRequestMode {
  DRIVE
  WALK
  TRANSIT
}

enum RoutePreference {
  RECOMMENDED
  FASTEST
  LOW_COST
  FEWER_TRANSFERS
  LESS_WALKING
}

enum NodeCategory {
  CITY
  PLACE
  SIGHT
  RESTAURANT
  HOTEL
  ACTIVITY
  TRANSIT
}

enum PlaceCategory {
  SIGHT
  PARK
  MUSEUM
  CULTURE
  PERFORMANCE
  SPORTS
  ENTERTAINMENT
  RESTAURANT
  HOTEL
  TRANSIT
  OTHER
}

enum PlaceSourceQuality {
  VERIFIED
  PROBABLE
  CANDIDATE
  NEEDS_REVIEW
}

model Route {
  id          String      @id @default(uuid())
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  version     Int         @default(1)
  visibility  String      @default("private")
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  nodes       RouteNode[]
  edges       RouteEdge[]

  @@index([ownerId])
}

model RouteNode {
  id                 String       @id @default(uuid())
  routeId            String
  route              Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name               String
  lat                Float
  lng                Float
  placeId            String?
  place              Place?       @relation("RouteNodePlace", fields: [placeId], references: [id], onDelete: SetNull)
  coordinateSystem   String?
  coordinateProvider String?
  providerPlaceId    String?
  order              Int
  category           NodeCategory
  durationMinutes    Int?
  notes              String?
  subPlan            SubPlan?
  outgoingEdges      RouteEdge[]  @relation("RouteEdgeFrom")
  incomingEdges      RouteEdge[]  @relation("RouteEdgeTo")

  @@unique([routeId, order])
  @@index([routeId])
  @@index([placeId])
}

model RouteEdge {
  id              String            @id @default(uuid())
  routeId         String
  route           Route             @relation(fields: [routeId], references: [id], onDelete: Cascade)
  fromNodeId      String            @unique
  fromNode        RouteNode         @relation("RouteEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId        String            @unique
  toNode          RouteNode         @relation("RouteEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  status          EdgeStatus
  transportMode   TransportMode?
  durationMinutes Int?
  distanceKm      Float?
  costEstimate    Float?
  notes           String?
  requestMode     RouteRequestMode?
  departAt        DateTime?
  preference      RoutePreference?
  selectedPlanId  String?
  planningStatus  String?
  planningWarning String?
  plans           RoutePlan[]       @relation("RouteEdgePlans")

  @@index([routeId])
}

model SubPlan {
  id          String        @id @default(uuid())
  routeNodeId String        @unique
  routeNode   RouteNode     @relation(fields: [routeNodeId], references: [id], onDelete: Cascade)
  nodes       SubPlanNode[]
  edges       SubPlanEdge[]
}

model SubPlanNode {
  id                 String        @id @default(uuid())
  subPlanId          String
  subPlan            SubPlan       @relation(fields: [subPlanId], references: [id], onDelete: Cascade)
  name               String
  lat                Float
  lng                Float
  placeId            String?
  place              Place?        @relation("SubPlanNodePlace", fields: [placeId], references: [id], onDelete: SetNull)
  coordinateSystem   String?
  coordinateProvider String?
  providerPlaceId    String?
  order              Int
  category           NodeCategory
  durationMinutes    Int?
  notes              String?
  outgoingEdges      SubPlanEdge[] @relation("SubPlanEdgeFrom")
  incomingEdges      SubPlanEdge[] @relation("SubPlanEdgeTo")

  @@unique([subPlanId, order])
  @@index([subPlanId])
  @@index([placeId])
}

model SubPlanEdge {
  id              String            @id @default(uuid())
  subPlanId       String
  subPlan         SubPlan           @relation(fields: [subPlanId], references: [id], onDelete: Cascade)
  fromNodeId      String            @unique
  fromNode        SubPlanNode       @relation("SubPlanEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId        String            @unique
  toNode          SubPlanNode       @relation("SubPlanEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  status          EdgeStatus
  transportMode   TransportMode?
  durationMinutes Int?
  distanceKm      Float?
  costEstimate    Float?
  notes           String?
  requestMode     RouteRequestMode?
  departAt        DateTime?
  preference      RoutePreference?
  selectedPlanId  String?
  planningStatus  String?
  planningWarning String?
  plans           RoutePlan[]       @relation("SubPlanEdgePlans")

  @@index([subPlanId])
}

model RoutePlan {
  id                 String         @id
  routeEdgeId        String?
  routeEdge          RouteEdge?     @relation("RouteEdgePlans", fields: [routeEdgeId], references: [id], onDelete: Cascade)
  subPlanEdgeId      String?
  subPlanEdge        SubPlanEdge?   @relation("SubPlanEdgePlans", fields: [subPlanEdgeId], references: [id], onDelete: Cascade)
  provider           String
  rank               Int
  label              String
  strategy           String
  distanceMeters     Float
  durationSeconds    Int
  fareAmount         Float?
  trafficBasis       String
  calculatedAt       DateTime
  validUntil         DateTime?
  requestFingerprint String
  segments           RouteSegment[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([routeEdgeId])
  @@index([subPlanEdgeId])
  @@index([requestFingerprint])
}

model RouteSegment {
  id                  String    @id
  routePlanId         String
  routePlan           RoutePlan @relation(fields: [routePlanId], references: [id], onDelete: Cascade)
  order               Int
  mode                String
  fromName            String?
  toName              String?
  lineName            String?
  distanceMeters      Float?
  durationSeconds     Int?
  fareAmount          Float?
  departAt            DateTime?
  arriveAt            DateTime?
  coordinateSystem    String
  geometryKind        String
  positionsJson       String
  trafficSectionsJson String?

  @@unique([routePlanId, order])
  @@index([routePlanId])
}

model User {
  id            String         @id
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  role          String?        @default("user")
  banned        Boolean?       @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  routes        Route[]
  photos        Photo[]
  agentSessions AgentSession[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Photo {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  url       String
  filePath  String
  lat       Float
  lng       Float
  caption   String?
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([createdAt])
}

model AgentSession {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Place {
  id              String               @id @default(uuid())
  name            String
  normalizedName  String
  category        PlaceCategory
  latWgs84        Float?
  lngWgs84        Float?
  latGcj02        Float?
  lngGcj02        Float?
  countryCode     String?
  province        String?
  city            String?
  district        String?
  address         String?
  description     String?
  popularityScore Float?
  sourceQuality   PlaceSourceQuality   @default(CANDIDATE)
  aliases         PlaceAlias[]
  sources         PlaceSource[]
  providerMatches PlaceProviderMatch[]
  routeNodes      RouteNode[]          @relation("RouteNodePlace")
  subPlanNodes    SubPlanNode[]        @relation("SubPlanNodePlace")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([normalizedName])
  @@index([city])
  @@index([category])
  @@index([sourceQuality])
}

model PlaceAlias {
  id             String   @id @default(uuid())
  placeId        String
  place          Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  locale         String?
  createdAt      DateTime @default(now())

  @@unique([placeId, normalizedName])
  @@index([normalizedName])
}

model PlaceSource {
  id          String   @id @default(uuid())
  placeId     String
  place       Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  provider    String
  providerId  String
  license     String
  rawName     String
  rawCategory String?
  rawPayload  String?
  fetchedAt   DateTime @default(now())

  @@unique([provider, providerId])
  @@index([placeId])
  @@index([provider])
}

model PlaceProviderMatch {
  id               String   @id @default(uuid())
  placeId          String
  place            Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  provider         String
  providerId       String
  confidence       Float
  coordinateSystem String
  lat              Float
  lng              Float
  address          String?
  adcode           String?
  typeCode         String?
  matchedAt        DateTime @default(now())

  @@unique([provider, providerId])
  @@index([placeId])
  @@index([provider])
}

model RawPlaceCandidate {
  id               String         @id @default(uuid())
  provider         String
  providerId       String?
  queryHash        String?
  name             String
  normalizedName   String
  category         PlaceCategory?
  lat              Float?
  lng              Float?
  coordinateSystem String?
  rawPayload       String?
  confidence       Float          @default(0)
  status           String         @default("CACHED")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([provider, providerId])
  @@index([normalizedName])
  @@index([queryHash])
}

model ProviderRequestCache {
  id           String    @id @default(uuid())
  provider     String
  cacheKey     String    @unique
  responseJson String
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([provider])
  @@index([expiresAt])
}

model ProviderUsageLog {
  id        String   @id @default(uuid())
  provider  String
  purpose   String
  status    String
  code      String?
  createdAt DateTime @default(now())

  @@index([provider, purpose])
  @@index([createdAt])
}

model EdgeGeometryCache {
  key       String   @id
  source    String
  positions String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
