generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum JourneyStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum JourneyEventType {
  SECTION
  VISIT
  TRANSIT
  STAY
  MEAL
  ACTIVITY
  NOTE
}

enum JourneyEventExecutionStatus {
  PLANNED
  STARTED
  CONFIRMED
  SKIPPED
  CANCELLED
}

enum JourneyEventOrigin {
  ORIGINAL
  USER_INSERTED
  AGENT_INSERTED
  FORKED
  SOURCE_DERIVED
}

enum JourneyEventLinkKind {
  MAIN
  ALTERNATIVE
}

enum JourneySectionKind {
  CITY
  DAY
  THEME
}

enum TransportMode {
  FLIGHT
  TRAIN
  CAR
  BUS
  WALK
  TAXI
  SUBWAY
  RENTAL
}

enum TransitRequestMode {
  DRIVE
  WALK
  TRANSIT
}

enum TransitPreference {
  RECOMMENDED
  FASTEST
  LOW_COST
  FEWER_TRANSFERS
  LESS_WALKING
}

enum PlaceCategory {
  SIGHT
  PARK
  MUSEUM
  CULTURE
  PERFORMANCE
  SPORTS
  ENTERTAINMENT
  RESTAURANT
  HOTEL
  TRANSIT
  OTHER
}

enum PlaceSourceQuality {
  VERIFIED
  PROBABLE
  CANDIDATE
  NEEDS_REVIEW
}

model Journey {
  id          String                 @id @default(uuid())
  ownerId     String
  owner       User                   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  revision    Int                    @default(1)
  status      JourneyStatus          @default(DRAFT)
  visibility  String                 @default("private")
  title       String
  description String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  events      JourneyEvent[]
  links       JourneyEventLink[]
  revisions   JourneyEventRevision[]

  @@index([ownerId])
}

model JourneyEvent {
  id                         String                       @id @default(uuid())
  journeyId                  String
  journey                    Journey                      @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  parentEventId              String?
  parentEvent                JourneyEvent?                @relation("JourneyEventChildren", fields: [parentEventId], references: [id], onDelete: Cascade)
  childEvents                JourneyEvent[]               @relation("JourneyEventChildren")
  replacedByEventId          String?
  replacedByEvent            JourneyEvent?                @relation("JourneyEventReplacement", fields: [replacedByEventId], references: [id], onDelete: SetNull)
  replaces                   JourneyEvent[]               @relation("JourneyEventReplacement")
  type                       JourneyEventType
  executionStatus            JourneyEventExecutionStatus?
  origin                     JourneyEventOrigin           @default(ORIGINAL)
  title                      String
  description                String?
  plannedStartAt             DateTime?
  plannedEndAt               DateTime?
  actualStartAt              DateTime?
  actualEndAt                DateTime?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  sectionDetail              SectionEventDetail?
  visitDetail                VisitEventDetail?
  transitDetail              TransitEventDetail?          @relation("TransitEventOwner")
  stayDetail                 StayEventDetail?
  mealDetail                 MealEventDetail?
  activityDetail             ActivityEventDetail?
  noteDetail                 NoteEventDetail?
  outgoingLinks              JourneyEventLink[]           @relation("JourneyEventLinkFrom")
  incomingLinks              JourneyEventLink[]           @relation("JourneyEventLinkTo")
  plannedTransitOrigins      TransitEventDetail[]         @relation("TransitPlannedFrom")
  plannedTransitDestinations TransitEventDetail[]         @relation("TransitPlannedTo")
  actualTransitOrigins       TransitEventDetail[]         @relation("TransitActualFrom")
  actualTransitDestinations  TransitEventDetail[]         @relation("TransitActualTo")
  revisions                  JourneyEventRevision[]
  attachments                JourneyEventAttachment[]

  @@index([journeyId])
  @@index([parentEventId])
  @@index([type])
  @@index([executionStatus])
}

model JourneyEventLink {
  id          String               @id @default(uuid())
  journeyId   String
  journey     Journey              @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  fromEventId String
  fromEvent   JourneyEvent         @relation("JourneyEventLinkFrom", fields: [fromEventId], references: [id], onDelete: Cascade)
  toEventId   String
  toEvent     JourneyEvent         @relation("JourneyEventLinkTo", fields: [toEventId], references: [id], onDelete: Cascade)
  kind        JourneyEventLinkKind @default(MAIN)
  branchKey   String?
  rank        String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([journeyId, fromEventId, toEventId, kind])
  @@index([journeyId, kind])
  @@index([fromEventId])
  @@index([toEventId])
}

model SectionEventDetail {
  eventId            String             @id
  event              JourneyEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind               JourneySectionKind
  placeId            String?
  place              Place?             @relation("SectionEventPlace", fields: [placeId], references: [id], onDelete: SetNull)
  lat                Float?
  lng                Float?
  coordinateSystem   String?
  coordinateProvider String?
  providerPlaceId    String?

  @@index([placeId])
}

model VisitEventDetail {
  eventId                String       @id
  event                  JourneyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  plannedPlaceId         String?
  plannedPlace           Place?       @relation("VisitPlannedPlace", fields: [plannedPlaceId], references: [id], onDelete: SetNull)
  actualPlaceId          String?
  actualPlace            Place?       @relation("VisitActualPlace", fields: [actualPlaceId], references: [id], onDelete: SetNull)
  plannedLat             Float
  plannedLng             Float
  actualLat              Float?
  actualLng              Float?
  coordinateSystem       String?
  coordinateProvider     String?
  providerPlaceId        String?
  plannedDurationMinutes Int?
  actualDurationMinutes  Int?

  @@index([plannedPlaceId])
  @@index([actualPlaceId])
}

model StayEventDetail {
  eventId                String       @id
  event                  JourneyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  plannedPlaceId         String?
  plannedPlace           Place?       @relation("StayPlannedPlace", fields: [plannedPlaceId], references: [id], onDelete: SetNull)
  actualPlaceId          String?
  actualPlace            Place?       @relation("StayActualPlace", fields: [actualPlaceId], references: [id], onDelete: SetNull)
  plannedLat             Float
  plannedLng             Float
  actualLat              Float?
  actualLng              Float?
  coordinateSystem       String?
  coordinateProvider     String?
  providerPlaceId        String?
  plannedDurationMinutes Int?
  actualDurationMinutes  Int?
  checkInNote            String?

  @@index([plannedPlaceId])
  @@index([actualPlaceId])
}

model MealEventDetail {
  eventId                String       @id
  event                  JourneyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  plannedPlaceId         String?
  plannedPlace           Place?       @relation("MealPlannedPlace", fields: [plannedPlaceId], references: [id], onDelete: SetNull)
  actualPlaceId          String?
  actualPlace            Place?       @relation("MealActualPlace", fields: [actualPlaceId], references: [id], onDelete: SetNull)
  plannedLat             Float
  plannedLng             Float
  actualLat              Float?
  actualLng              Float?
  coordinateSystem       String?
  coordinateProvider     String?
  providerPlaceId        String?
  plannedDurationMinutes Int?
  actualDurationMinutes  Int?
  cuisine                String?

  @@index([plannedPlaceId])
  @@index([actualPlaceId])
}

model ActivityEventDetail {
  eventId                String       @id
  event                  JourneyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  plannedPlaceId         String?
  plannedPlace           Place?       @relation("ActivityPlannedPlace", fields: [plannedPlaceId], references: [id], onDelete: SetNull)
  actualPlaceId          String?
  actualPlace            Place?       @relation("ActivityActualPlace", fields: [actualPlaceId], references: [id], onDelete: SetNull)
  plannedLat             Float
  plannedLng             Float
  actualLat              Float?
  actualLng              Float?
  coordinateSystem       String?
  coordinateProvider     String?
  providerPlaceId        String?
  plannedDurationMinutes Int?
  actualDurationMinutes  Int?
  bookingReference       String?

  @@index([plannedPlaceId])
  @@index([actualPlaceId])
}

model TransitEventDetail {
  eventId                String              @id
  event                  JourneyEvent        @relation("TransitEventOwner", fields: [eventId], references: [id], onDelete: Cascade)
  plannedFromEventId     String?
  plannedFromEvent       JourneyEvent?       @relation("TransitPlannedFrom", fields: [plannedFromEventId], references: [id], onDelete: SetNull)
  plannedToEventId       String?
  plannedToEvent         JourneyEvent?       @relation("TransitPlannedTo", fields: [plannedToEventId], references: [id], onDelete: SetNull)
  actualFromEventId      String?
  actualFromEvent        JourneyEvent?       @relation("TransitActualFrom", fields: [actualFromEventId], references: [id], onDelete: SetNull)
  actualToEventId        String?
  actualToEvent          JourneyEvent?       @relation("TransitActualTo", fields: [actualToEventId], references: [id], onDelete: SetNull)
  transportMode          TransportMode
  requestMode            TransitRequestMode?
  preference             TransitPreference?
  plannedDepartAt        DateTime?
  actualDepartAt         DateTime?
  plannedDurationMinutes Int?
  actualDurationMinutes  Int?
  plannedDistanceKm      Float?
  actualDistanceKm       Float?
  plannedCostEstimate    Float?
  actualCost             Float?
  selectedPlanId         String?
  planningStatus         String?
  planningWarning        String?
  notes                  String?
  plans                  TransitPlan[]

  @@index([plannedFromEventId])
  @@index([plannedToEventId])
}

model NoteEventDetail {
  eventId String       @id
  event   JourneyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  body    String
}

model TransitPlan {
  id                 String             @id
  transitEventId     String
  transitEvent       TransitEventDetail @relation(fields: [transitEventId], references: [eventId], onDelete: Cascade)
  provider           String
  rank               Int
  label              String
  strategy           String
  distanceMeters     Float
  durationSeconds    Int
  fareAmount         Float?
  trafficBasis       String
  calculatedAt       DateTime
  validUntil         DateTime?
  requestFingerprint String
  segments           TransitSegment[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([transitEventId])
  @@index([requestFingerprint])
}

model TransitSegment {
  id                  String      @id
  transitPlanId       String
  transitPlan         TransitPlan @relation(fields: [transitPlanId], references: [id], onDelete: Cascade)
  order               Int
  mode                String
  fromName            String?
  toName              String?
  lineName            String?
  distanceMeters      Float?
  durationSeconds     Int?
  fareAmount          Float?
  departAt            DateTime?
  arriveAt            DateTime?
  coordinateSystem    String
  geometryKind        String
  positionsJson       String
  trafficSectionsJson String?

  @@unique([transitPlanId, order])
  @@index([transitPlanId])
}

model JourneyEventRevision {
  id               String        @id @default(uuid())
  journeyId        String
  journey          Journey       @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  eventId          String?
  event            JourneyEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  journeyRevision  Int
  operation        String
  patchJson        String
  inversePatchJson String?
  actorId          String
  idempotencyKey   String?
  createdAt        DateTime      @default(now())

  @@unique([journeyId, idempotencyKey])
  @@index([journeyId, journeyRevision])
  @@index([eventId])
}

model JourneyEventAttachment {
  id        String       @id @default(uuid())
  eventId   String
  event     JourneyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      String
  url       String
  metadata  String?
  createdAt DateTime     @default(now())

  @@index([eventId])
}

model User {
  id            String         @id
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  role          String?        @default("user")
  banned        Boolean?       @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  journeys      Journey[]
  photos        Photo[]
  agentSessions AgentSession[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Photo {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  url       String
  filePath  String
  lat       Float
  lng       Float
  caption   String?
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([createdAt])
}

model AgentSession {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Place {
  id                    String                @id @default(uuid())
  name                  String
  normalizedName        String
  category              PlaceCategory
  latWgs84              Float?
  lngWgs84              Float?
  latGcj02              Float?
  lngGcj02              Float?
  countryCode           String?
  province              String?
  city                  String?
  district              String?
  address               String?
  description           String?
  popularityScore       Float?
  sourceQuality         PlaceSourceQuality    @default(CANDIDATE)
  aliases               PlaceAlias[]
  sources               PlaceSource[]
  providerMatches       PlaceProviderMatch[]
  sectionEvents         SectionEventDetail[]  @relation("SectionEventPlace")
  plannedVisitEvents    VisitEventDetail[]    @relation("VisitPlannedPlace")
  actualVisitEvents     VisitEventDetail[]    @relation("VisitActualPlace")
  plannedStayEvents     StayEventDetail[]     @relation("StayPlannedPlace")
  actualStayEvents      StayEventDetail[]     @relation("StayActualPlace")
  plannedMealEvents     MealEventDetail[]     @relation("MealPlannedPlace")
  actualMealEvents      MealEventDetail[]     @relation("MealActualPlace")
  plannedActivityEvents ActivityEventDetail[] @relation("ActivityPlannedPlace")
  actualActivityEvents  ActivityEventDetail[] @relation("ActivityActualPlace")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([normalizedName])
  @@index([city])
  @@index([category])
  @@index([sourceQuality])
}

model PlaceAlias {
  id             String   @id @default(uuid())
  placeId        String
  place          Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  locale         String?
  createdAt      DateTime @default(now())

  @@unique([placeId, normalizedName])
  @@index([normalizedName])
}

model PlaceSource {
  id          String   @id @default(uuid())
  placeId     String
  place       Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  provider    String
  providerId  String
  license     String
  rawName     String
  rawCategory String?
  rawPayload  String?
  fetchedAt   DateTime @default(now())

  @@unique([provider, providerId])
  @@index([placeId])
  @@index([provider])
}

model PlaceProviderMatch {
  id               String   @id @default(uuid())
  placeId          String
  place            Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  provider         String
  providerId       String
  confidence       Float
  coordinateSystem String
  lat              Float
  lng              Float
  address          String?
  adcode           String?
  typeCode         String?
  matchedAt        DateTime @default(now())

  @@unique([provider, providerId])
  @@index([placeId])
  @@index([provider])
}

model RawPlaceCandidate {
  id               String         @id @default(uuid())
  provider         String
  providerId       String?
  queryHash        String?
  name             String
  normalizedName   String
  category         PlaceCategory?
  lat              Float?
  lng              Float?
  coordinateSystem String?
  rawPayload       String?
  confidence       Float          @default(0)
  status           String         @default("CACHED")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([provider, providerId])
  @@index([normalizedName])
  @@index([queryHash])
}

model ProviderRequestCache {
  id           String    @id @default(uuid())
  provider     String
  cacheKey     String    @unique
  responseJson String
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([provider])
  @@index([expiresAt])
}

model ProviderUsageLog {
  id        String   @id @default(uuid())
  provider  String
  purpose   String
  status    String
  code      String?
  createdAt DateTime @default(now())

  @@index([provider, purpose])
  @@index([createdAt])
}
