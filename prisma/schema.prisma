generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JourneyStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum JourneyVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum CoordinateSystem {
  WGS84
  GCJ02
  BD09
  LOCAL
}

enum AssetKind {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum AssetVisibility {
  PRIVATE
  JOURNEY
  PUBLIC
}

enum EventAssetRole {
  COVER
  GALLERY
  RECEIPT
  REFERENCE
}

enum PlaceCategory {
  SIGHT
  PARK
  MUSEUM
  CULTURE
  PERFORMANCE
  SPORTS
  ENTERTAINMENT
  RESTAURANT
  HOTEL
  TRANSIT
  OTHER
}

enum PlaceSourceQuality {
  VERIFIED
  PROBABLE
  CANDIDATE
  NEEDS_REVIEW
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String?   @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions           Session[]           @relation("UserSessions")
  accounts           Account[]           @relation("UserAccounts")
  journeys           Journey[]           @relation("OwnedJourneys")
  assets             Asset[]             @relation("OwnedAssets")
  providerUsageLogs  ProviderUsageLog[]  @relation("UserProviderUsage")
  journeyMemberships JourneyMember[]
  journeyInvitations JourneyInvitation[]
  eventSources       JourneyEvent[]      @relation("EventSourceUser")
  journeyRevisions   JourneyRevision[]   @relation("JourneyUserActor")

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?

  user User @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation("UserAccounts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Journey {
  id           String            @id @default(uuid())
  ownerId      String
  revision     Int               @default(1)
  status       JourneyStatus     @default(DRAFT)
  visibility   JourneyVisibility @default(PRIVATE)
  title        String
  description  String?
  snapshotJson String
  deletedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  owner       User                @relation("OwnedJourneys", fields: [ownerId], references: [id], onDelete: Restrict)
  revisions   JourneyRevision[]   @relation("JourneyRevisions")
  events      JourneyEvent[]      @relation("JourneyEvents")
  assetLinks  EventAssetLink[]    @relation("JourneyAssetLinks")
  members     JourneyMember[]
  invitations JourneyInvitation[]

  @@index([ownerId])
  @@index([deletedAt])
}

model JourneyRevision {
  id               String   @id @default(uuid())
  journeyId        String
  revision         Int
  operation        String
  snapshotJson     String
  patchJson        String
  inversePatchJson String
  actorUserId      String
  idempotencyKey   String
  parentRevisionId String?
  createdAt        DateTime @default(now())

  actorUser User             @relation("JourneyUserActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  journey   Journey          @relation("JourneyRevisions", fields: [journeyId], references: [id], onDelete: Restrict)
  parent    JourneyRevision? @relation("JourneyRevisionLineage", fields: [journeyId, parentRevisionId], references: [journeyId, id], onDelete: Restrict)
  child     JourneyRevision? @relation("JourneyRevisionLineage")

  @@unique([journeyId, revision])
  @@unique([journeyId, id])
  @@unique([journeyId, parentRevisionId])
  @@unique([journeyId, idempotencyKey])
  @@index([createdAt])
}

model JourneyEvent {
  id           String           @id
  journeyId    String
  rank         Int
  sourceUserId String
  journey      Journey          @relation("JourneyEvents", fields: [journeyId], references: [id], onDelete: Restrict)
  source       User             @relation("EventSourceUser", fields: [sourceUserId], references: [id], onDelete: Restrict)
  assetLinks   EventAssetLink[] @relation("EventAssetLinks")

  @@unique([journeyId, id])
  @@unique([journeyId, rank])
  @@index([sourceUserId])
}

model Asset {
  id                String          @id @default(uuid())
  ownerId           String
  kind              AssetKind
  visibility        AssetVisibility @default(PRIVATE)
  storageKey        String          @unique
  originalName      String?
  mimeType          String
  sizeBytes         Int
  checksum          String
  uploadId          String?
  uploadFingerprint String?
  capturedAt        DateTime?
  lat               Float?
  lng               Float?
  createdAt         DateTime        @default(now())
  deletedAt         DateTime?

  owner      User             @relation("OwnedAssets", fields: [ownerId], references: [id], onDelete: Restrict)
  eventLinks EventAssetLink[] @relation("AssetEventLinks")

  @@unique([ownerId, uploadId])
  @@index([ownerId, createdAt])
  @@index([checksum])
  @@index([deletedAt])
}

model EventAssetLink {
  id        String         @id
  journeyId String
  eventId   String
  assetId   String
  role      EventAssetRole
  rank      Int
  journey   Journey        @relation("JourneyAssetLinks", fields: [journeyId], references: [id], onDelete: Restrict)
  event     JourneyEvent   @relation("EventAssetLinks", fields: [journeyId, eventId], references: [journeyId, id], onDelete: Cascade)
  asset     Asset          @relation("AssetEventLinks", fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([eventId, assetId, role])
  @@index([journeyId, eventId])
  @@index([assetId])
}

model Place {
  id              String             @id @default(uuid())
  name            String
  normalizedName  String
  category        PlaceCategory
  latWgs84        Float?
  lngWgs84        Float?
  latGcj02        Float?
  lngGcj02        Float?
  countryCode     String?
  province        String?
  city            String?
  district        String?
  address         String?
  description     String?
  popularityScore Float?
  sourceQuality   PlaceSourceQuality @default(CANDIDATE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  aliases         PlaceAlias[]         @relation("PlaceAliases")
  sources         PlaceSource[]        @relation("PlaceSources")
  providerMatches PlaceProviderMatch[] @relation("PlaceProviderMatches")

  @@index([normalizedName])
  @@index([city])
  @@index([category])
  @@index([sourceQuality])
}

model PlaceAlias {
  id             String   @id @default(uuid())
  placeId        String
  name           String
  normalizedName String
  locale         String?
  createdAt      DateTime @default(now())

  place Place @relation("PlaceAliases", fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, normalizedName])
  @@index([normalizedName])
}

model PlaceSource {
  id          String   @id @default(uuid())
  placeId     String
  provider    String
  providerId  String
  license     String
  rawName     String
  rawCategory String?
  rawPayload  String?
  fetchedAt   DateTime @default(now())

  place Place @relation("PlaceSources", fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([placeId])
  @@index([provider])
}

model PlaceProviderMatch {
  id               String           @id @default(uuid())
  placeId          String
  provider         String
  providerId       String
  confidence       Float
  coordinateSystem CoordinateSystem
  lat              Float
  lng              Float
  address          String?
  adcode           String?
  typeCode         String?
  matchedAt        DateTime         @default(now())

  place Place @relation("PlaceProviderMatches", fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([placeId])
  @@index([provider])
}

model RawPlaceCandidate {
  id               String            @id @default(uuid())
  provider         String
  providerId       String?
  queryHash        String?
  name             String
  normalizedName   String
  category         PlaceCategory?
  lat              Float?
  lng              Float?
  coordinateSystem CoordinateSystem?
  rawPayload       String?
  confidence       Float             @default(0)
  status           String            @default("CACHED")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([provider, providerId])
  @@index([normalizedName])
  @@index([queryHash])
}

model ProviderRequestCache {
  id           String    @id @default(uuid())
  provider     String
  cacheKey     String    @unique
  responseJson String
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([provider])
  @@index([expiresAt])
}

model ProviderUsageLog {
  id        String   @id @default(uuid())
  provider  String
  purpose   String
  status    String
  code      String?
  userId    String?
  requestId String?
  createdAt DateTime @default(now())

  user User? @relation("UserProviderUsage", fields: [userId], references: [id], onDelete: SetNull)

  @@index([provider, purpose])
  @@index([userId])
  @@index([requestId])
  @@index([createdAt])
}

model JourneyMember {
  journeyId String
  userId    String
  joinedAt  DateTime @default(now())
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([journeyId, userId])
  @@index([userId, journeyId])
}

model JourneyInvitation {
  id          String    @id @default(uuid())
  journeyId   String
  createdById String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  journey     Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([journeyId, createdAt])
}
