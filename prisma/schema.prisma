generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JourneyStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum JourneyVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum CoordinateSystem {
  WGS84
  GCJ02
  BD09
  LOCAL
}

enum AssetKind {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum AssetVisibility {
  PRIVATE
  JOURNEY
  PUBLIC
}

enum EventAssetRole {
  COVER
  GALLERY
  RECEIPT
  REFERENCE
}

enum PlaceCategory {
  SIGHT
  PARK
  MUSEUM
  CULTURE
  PERFORMANCE
  SPORTS
  ENTERTAINMENT
  RESTAURANT
  HOTEL
  TRANSIT
  OTHER
}

enum PlaceSourceQuality {
  VERIFIED
  PROBABLE
  CANDIDATE
  NEEDS_REVIEW
}

model User {
  oauthClient_userId       OauthClient[]       @relation("OauthClient_userId")
  oauthRefreshToken_userId OauthRefreshToken[] @relation("OauthRefreshToken_userId")
  oauthAccessToken_userId  OauthAccessToken[]  @relation("OauthAccessToken_userId")
  oauthConsent_userId      OauthConsent[]      @relation("OauthConsent_userId")
  id                       String              @id
  name                     String
  email                    String              @unique
  emailVerified            Boolean             @default(false)
  image                    String?
  role                     String?             @default("user")
  banned                   Boolean?            @default(false)
  banReason                String?
  banExpires               DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  sessions           Session[]           @relation("UserSessions")
  accounts           Account[]           @relation("UserAccounts")
  journeys           Journey[]           @relation("OwnedJourneys")
  assets             Asset[]             @relation("OwnedAssets")
  providerUsageLogs  ProviderUsageLog[]  @relation("UserProviderUsage")
  journeyMemberships JourneyMember[]
  journeyInvitations JourneyInvitation[]
  eventSources       JourneyEvent[]      @relation("EventSourceUser")
  journeyRevisions   JourneyRevision[]   @relation("JourneyUserActor")
  planningProposals  PlanningProposal[]
  agentGrants        AgentGrant[]

  @@map("user")
}

model Session {
  oauthRefreshToken_sessionId OauthRefreshToken[] @relation("OauthRefreshToken_sessionId")
  oauthAccessToken_sessionId  OauthAccessToken[]  @relation("OauthAccessToken_sessionId")
  id                          String              @id
  expiresAt                   DateTime
  token                       String              @unique
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  ipAddress                   String?
  userAgent                   String?
  userId                      String
  impersonatedBy              String?

  user User @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation("UserAccounts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Journey {
  id           String            @id @default(uuid())
  ownerId      String
  revision     Int               @default(1)
  status       JourneyStatus     @default(DRAFT)
  visibility   JourneyVisibility @default(PRIVATE)
  title        String
  description  String?
  snapshotJson String
  deletedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  owner             User                @relation("OwnedJourneys", fields: [ownerId], references: [id], onDelete: Restrict)
  revisions         JourneyRevision[]   @relation("JourneyRevisions")
  events            JourneyEvent[]      @relation("JourneyEvents")
  assetLinks        EventAssetLink[]    @relation("JourneyAssetLinks")
  members           JourneyMember[]
  invitations       JourneyInvitation[]
  weather           EventWeather[]
  share             JourneyShare?
  planningProposals PlanningProposal[]
  agentGrants       AgentGrant[]

  @@index([ownerId])
  @@index([deletedAt])
}

model JourneyRevision {
  id               String   @id @default(uuid())
  journeyId        String
  revision         Int
  operation        String
  snapshotJson     String
  patchJson        String
  inversePatchJson String
  actorUserId      String
  idempotencyKey   String
  parentRevisionId String?
  agentGrantId     String?
  createdAt        DateTime @default(now())

  actorUser  User             @relation("JourneyUserActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  agentGrant AgentGrant?      @relation(fields: [agentGrantId], references: [id], onDelete: Restrict)
  journey    Journey          @relation("JourneyRevisions", fields: [journeyId], references: [id], onDelete: Restrict)
  parent     JourneyRevision? @relation("JourneyRevisionLineage", fields: [journeyId, parentRevisionId], references: [journeyId, id], onDelete: Restrict)
  child      JourneyRevision? @relation("JourneyRevisionLineage")

  @@unique([journeyId, revision])
  @@unique([journeyId, id])
  @@unique([journeyId, parentRevisionId])
  @@unique([journeyId, idempotencyKey])
  @@index([createdAt])
}

model JourneyEvent {
  id           String           @id
  journeyId    String
  rank         Int
  sourceUserId String
  journey      Journey          @relation("JourneyEvents", fields: [journeyId], references: [id], onDelete: Restrict)
  source       User             @relation("EventSourceUser", fields: [sourceUserId], references: [id], onDelete: Restrict)
  assetLinks   EventAssetLink[] @relation("EventAssetLinks")

  @@unique([journeyId, id])
  @@unique([journeyId, rank])
  @@index([sourceUserId])
}

model Asset {
  id                String          @id @default(uuid())
  ownerId           String
  kind              AssetKind
  visibility        AssetVisibility @default(PRIVATE)
  storageKey        String          @unique
  originalName      String?
  mimeType          String
  sizeBytes         Int
  checksum          String
  uploadId          String?
  uploadFingerprint String?
  agentGrantId      String?
  capturedAt        DateTime?
  lat               Float?
  lng               Float?
  createdAt         DateTime        @default(now())
  deletedAt         DateTime?

  owner      User                @relation("OwnedAssets", fields: [ownerId], references: [id], onDelete: Restrict)
  eventLinks EventAssetLink[]    @relation("AssetEventLinks")
  shareLinks JourneyShareAsset[]
  agentGrant AgentGrant?         @relation(fields: [agentGrantId], references: [id], onDelete: Restrict)

  @@unique([ownerId, uploadId])
  @@index([ownerId, createdAt])
  @@index([checksum])
  @@index([deletedAt])
}

model EventAssetLink {
  id        String         @id
  journeyId String
  eventId   String
  assetId   String
  role      EventAssetRole
  rank      Int
  journey   Journey        @relation("JourneyAssetLinks", fields: [journeyId], references: [id], onDelete: Restrict)
  event     JourneyEvent   @relation("EventAssetLinks", fields: [journeyId, eventId], references: [journeyId, id], onDelete: Cascade)
  asset     Asset          @relation("AssetEventLinks", fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([eventId, assetId, role])
  @@index([journeyId, eventId])
  @@index([assetId])
}

model Place {
  id              String             @id @default(uuid())
  name            String
  normalizedName  String
  category        PlaceCategory
  latWgs84        Float?
  lngWgs84        Float?
  latGcj02        Float?
  lngGcj02        Float?
  countryCode     String?
  province        String?
  city            String?
  district        String?
  address         String?
  description     String?
  popularityScore Float?
  sourceQuality   PlaceSourceQuality @default(CANDIDATE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  aliases         PlaceAlias[]         @relation("PlaceAliases")
  sources         PlaceSource[]        @relation("PlaceSources")
  providerMatches PlaceProviderMatch[] @relation("PlaceProviderMatches")

  @@index([normalizedName])
  @@index([city])
  @@index([category])
  @@index([sourceQuality])
}

model PlaceAlias {
  id             String   @id @default(uuid())
  placeId        String
  name           String
  normalizedName String
  locale         String?
  createdAt      DateTime @default(now())

  place Place @relation("PlaceAliases", fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, normalizedName])
  @@index([normalizedName])
}

model PlaceSource {
  id          String   @id @default(uuid())
  placeId     String
  provider    String
  providerId  String
  license     String
  rawName     String
  rawCategory String?
  rawPayload  String?
  fetchedAt   DateTime @default(now())

  place Place @relation("PlaceSources", fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([placeId])
  @@index([provider])
}

model PlaceProviderMatch {
  id               String           @id @default(uuid())
  placeId          String
  provider         String
  providerId       String
  confidence       Float
  coordinateSystem CoordinateSystem
  lat              Float
  lng              Float
  address          String?
  adcode           String?
  typeCode         String?
  matchedAt        DateTime         @default(now())

  place Place @relation("PlaceProviderMatches", fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([placeId])
  @@index([provider])
}

model RawPlaceCandidate {
  id               String            @id @default(uuid())
  provider         String
  providerId       String?
  queryHash        String?
  name             String
  normalizedName   String
  category         PlaceCategory?
  lat              Float?
  lng              Float?
  coordinateSystem CoordinateSystem?
  rawPayload       String?
  confidence       Float             @default(0)
  status           String            @default("CACHED")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([provider, providerId])
  @@index([normalizedName])
  @@index([queryHash])
}

model ProviderRequestCache {
  id           String    @id @default(uuid())
  provider     String
  cacheKey     String    @unique
  responseJson String
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([provider])
  @@index([expiresAt])
}

model ProviderUsageLog {
  id        String   @id @default(uuid())
  provider  String
  purpose   String
  status    String
  code      String?
  userId    String?
  requestId String?
  createdAt DateTime @default(now())

  user User? @relation("UserProviderUsage", fields: [userId], references: [id], onDelete: SetNull)

  @@index([provider, purpose])
  @@index([userId])
  @@index([requestId])
  @@index([createdAt])
}

model JourneyMember {
  journeyId String
  userId    String
  joinedAt  DateTime @default(now())
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([journeyId, userId])
  @@index([userId, journeyId])
}

model JourneyInvitation {
  id          String    @id @default(uuid())
  journeyId   String
  createdById String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  journey     Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([journeyId, createdAt])
}

// Current derived weather belongs to stable Journey identity, not rebuilt event indexes.
model EventWeather {
  journeyId  String
  eventId    String
  inputKey   String
  queryJson  String
  resultJson String
  fetchedAt  DateTime
  journey    Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@id([journeyId, eventId])
}

model JourneyShare {
  id                    String              @id @default(uuid())
  journeyId             String              @unique
  token                 String              @unique
  version               Int
  sourceRevision        Int
  includeCosts          Boolean
  snapshotJson          String
  publishedAt           DateTime
  updatedAt             DateTime            @updatedAt
  revokedAt             DateTime?
  lastMutationId        String
  lastMutationSignature String
  journey               Journey             @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  assets                JourneyShareAsset[]
}

model JourneyShareAsset {
  shareId String
  assetId String
  share   JourneyShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  asset   Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([shareId, assetId])
  @@index([assetId])
}

model AgentGrant {
  id               String            @id @default(uuid())
  userId           String
  clientId         String
  journeyId        String
  authorizationKey String            @unique
  scopes           String[]
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime          @default(now())
  lastUsedAt       DateTime?
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  journey          Journey           @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  assets           Asset[]
  revisions        JourneyRevision[]

  @@index([journeyId, userId])
  @@index([userId, clientId])
}

model OauthClient {
  oauthClientResource_clientId     OauthClientResource[] @relation("OauthClientResource_clientId")
  oauthRefreshToken_clientId       OauthRefreshToken[]   @relation("OauthRefreshToken_clientId")
  oauthAccessToken_clientId        OauthAccessToken[]    @relation("OauthAccessToken_clientId")
  oauthConsent_clientId            OauthConsent[]        @relation("OauthConsent_clientId")
  id                               String                @id
  clientId                         String                @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]              @default([])
  clientCredentialsScopes          String[]              @default([])
  userId                           String?
  userIdRelation                   User?                 @relation("OauthClient_userId", fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?             @default(now())
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]              @default([])
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]              @default([])
  postLogoutRedirectUris           String[]              @default([])
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]              @default([])
  responseTypes                    String[]              @default([])
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?

  @@index([userId])
}

model OauthResource {
  oauthClientResource_resourceId OauthClientResource[] @relation("OauthClientResource_resourceId")
  id                             String                @id
  identifier                     String                @unique
  name                           String
  accessTokenTtl                 Int?
  refreshTokenTtl                Int?
  signingAlgorithm               String?
  signingKeyId                   String?
  allowedScopes                  String[]              @default([])
  customClaims                   Json?
  dpopBoundAccessTokensRequired  Boolean?              @default(false)
  disabled                       Boolean?              @default(false)
  createdAt                      DateTime?             @default(now())
  updatedAt                      DateTime?
  policyVersion                  Int?                  @default(1)
  metadata                       Json?
}

model OauthClientResource {
  id                 String        @id
  clientId           String
  clientIdRelation   OauthClient   @relation("OauthClientResource_clientId", fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId         String
  resourceIdRelation OauthResource @relation("OauthClientResource_resourceId", fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata           Json?
  createdAt          DateTime?     @default(now())

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
}

model OauthRefreshToken {
  oauthAccessToken_refreshId OauthAccessToken[] @relation("OauthAccessToken_refreshId")
  id                         String             @id
  token                      String             @unique
  clientId                   String
  clientIdRelation           OauthClient        @relation("OauthRefreshToken_clientId", fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId                  String?
  sessionIdRelation          Session?           @relation("OauthRefreshToken_sessionId", fields: [sessionId], references: [id], onDelete: SetNull)
  userId                     String
  userIdRelation             User               @relation("OauthRefreshToken_userId", fields: [userId], references: [id], onDelete: Cascade)
  referenceId                String?
  authorizationCodeId        String?
  resources                  String[]           @default([])
  requestedUserInfoClaims    String[]           @default([])
  expiresAt                  DateTime
  createdAt                  DateTime           @default(now())
  revoked                    DateTime?
  rotatedAt                  DateTime?
  rotationReplayResponse     String?
  rotationReplayExpiresAt    DateTime?
  authTime                   DateTime?
  confirmation               Json?
  scopes                     String[]           @default([])

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
}

model OauthAccessToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  clientIdRelation        OauthClient        @relation("OauthAccessToken_clientId", fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  sessionIdRelation       Session?           @relation("OauthAccessToken_sessionId", fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  userIdRelation          User?              @relation("OauthAccessToken_userId", fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]           @default([])
  requestedUserInfoClaims String[]           @default([])
  refreshId               String?
  refreshIdRelation       OauthRefreshToken? @relation("OauthAccessToken_refreshId", fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime
  createdAt               DateTime           @default(now())
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]           @default([])

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
}

model OauthConsent {
  id                      String      @id
  clientId                String
  clientIdRelation        OauthClient @relation("OauthConsent_clientId", fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  userIdRelation          User?       @relation("OauthConsent_userId", fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]    @default([])
  requestedUserInfoClaims String[]    @default([])
  scopes                  String[]    @default([])
  createdAt               DateTime    @default(now())
  updatedAt               DateTime

  @@index([clientId])
  @@index([userId])
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime
}

model PlanningProposal {
  id            String            @id
  userId        String
  journeyId     String
  requestId     String
  signature     String
  status        String            @default("OPEN")
  baseRevision  Int
  latestVersion Int               @default(0)
  activeRunId   String?
  latestRunId   String
  questionRunId String?
  createdAt     DateTime          @default(now())
  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  journey       Journey           @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  runs          PlanningRun[]
  versions      PlanningVersion[]
  receipt       PlanningReceipt?

  @@unique([userId, journeyId, requestId])
  @@index([journeyId])
}

model PlanningRun {
  id             String           @id
  proposalId     String
  requestId      String
  signature      String
  inputJson      String
  parentVersion  Int
  targetRevision Int
  mode           String
  status         String           @default("RUNNING")
  deadline       DateTime
  questionJson   String?
  errorJson      String?
  createdAt      DateTime         @default(now())
  proposal       PlanningProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, requestId])
}

model PlanningVersion {
  proposalId      String
  version         Int
  baseRevision    Int
  operationsJson  String
  sourcesJson     String
  factsJson       String
  constraintsJson String
  unverifiedJson  String
  snapshotJson    String
  previewJson     String
  createdAt       DateTime         @default(now())
  proposal        PlanningProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@id([proposalId, version])
}

model PlanningReceipt {
  proposalId      String           @id
  userId          String
  journeyId       String
  version         Int
  appliedRevision Int
  createdAt       DateTime         @default(now())
  proposal        PlanningProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
}
